# ───────────────────────────────────────────────
# APPMY 백엔드 로컬 실행용 환경변수 템플릿
# 이 파일을 복사해서 ".env" 로 만들고 실제 값을 채우세요.
#   (PowerShell)  Copy-Item .env.example .env
# 실제 값은 cloudtype(운영 배포) 환경변수 대시보드에서 그대로 가져오면 됩니다.
# ───────────────────────────────────────────────

# [필수] 없으면 서버가 즉시 종료됩니다 (process.exit)
MONGODB_URI=
DB_NAME=
CAFE24_CLIENT_ID=
CAFE24_CLIENT_SECRET=
CAFE24_API_VERSION=2025-06-01
CAFE24_SCOPES=mall.read_category,mall.read_product,mall.read_promotion
# 로컬 테스트 시:
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# [선택] 서버 포트 (기본 5000)
PORT=5000

# ★ [로컬 테스트 전용 · 매우 중요] ★
# 운영 MongoDB(MONGODB_URI/DB_NAME 을 운영과 동일하게 사용)에 붙어
# yogibo 토큰을 그대로 쓰려는 경우 반드시 1 로 두세요.
# 이 값을 1 로 두면 시작 시 전체 토큰 갱신 + 30분 크론이 비활성화되어,
# 로컬 인스턴스가 다른 고객 몰들의 라이브 토큰을 건드리지 않습니다.
# (운영 배포에는 이 줄을 넣지 마세요)
DISABLE_TOKEN_CRON=1

# [선택] 이미지 업로드(R2/S3) — 이미지 블록 저장 시 필요
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_REGION=us-east-1
R2_PUBLIC_BASE=

# [선택] 앱 삭제 웹훅 토큰
UNINSTALL_TOKEN=
